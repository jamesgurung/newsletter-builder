@page
@{
  ViewData["BodyClass"] = "login-page";
  var returnUrl = Request.Query["path"].FirstOrDefault();
}
<div class="sign-in-panel">
  <a class="secondary-button" href="/auth/login/challenge@(string.IsNullOrEmpty(returnUrl) ? string.Empty : $"?path={returnUrl}")">Sign in to newsletter builder</a>
</div>
